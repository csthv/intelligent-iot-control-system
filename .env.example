# PC serial ports
ESP32_PORT=COM13
ARDUINO_PORT=COM4
BAUD_RATE=115200

# LLM endpoint (OpenAI-compatible)
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=replace_with_your_api_key

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# ESP32 local web interface
ESP32_AP_IP=192.168.4.1
ESP32_WEB_USERNAME=admin
ESP32_WEB_PASSWORD=change-me

# Captured images
IMAGE_OUTPUT_DIR=data/captures
